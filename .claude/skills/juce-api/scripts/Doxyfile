# Overlay on JUCE's own Doxyfile: same inputs, excludes and predefines, XML out.
# generate.sh mounts the fetched JUCE tree at /work/juce and runs from
# /work/juce/docs/doxygen, because JUCE's INPUT and EXCLUDE paths are relative
# to it (../../modules). STRIP_FROM_PATH leaves juce/modules/... locations,
# which convert.py maps to the tree's repo-relative path.
@INCLUDE               = /work/juce/docs/doxygen/Doxyfile
STRIP_FROM_PATH        = /work/
OUTPUT_DIRECTORY       = /out
GENERATE_HTML          = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
HAVE_DOT               = NO
GENERATE_TAGFILE       =
QUIET                  = YES
WARNINGS               = NO
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = NO
WARN_IF_INCOMPLETE_DOC = NO
