+    // ear: ixwebsocket-limits.patch. The most sockets one address holds: twice sendspin-cpp's own
+    // budget for a whole listener (a connection admitted, two proving themselves, one spare), as
+    // honest servers can share an address behind a NAT or a proxy.
+    static const size_t kSocketsPerAddress(8);
+
+    bool WebSocketServer::admitConnection(const std::shared_ptr<ConnectionState>& connectionState,
+                                          int fd)
+    {
+        // A socket that has not upgraded proves nothing, so a full room never refuses the newcomer
+        // while one of those is in it: it gives way, the oldest of the newcomer's own address once
+        // that address has its share, or else the oldest of the address holding most. So a holder
+        // of sockets keeps no one out, and one address, however fast, touches no other's. The
+        // second bound holds the threads if sockets that gave way are slow to go.
+        //
+        // An address holds only the sockets its peer has not closed: one closed waits for its own
+        // thread to see it before it leaves the list, and on a loaded host that can take longer
+        // than an honest server takes to come back, which its own closed sockets must not refuse.
+        // The kernel knows at once; every socket's thread still counts against the second bound.
+        // A socket that gave way (the shutdown below) shows POLLHUP, so it leaves its address's
+        // count at once too. Each socket is polled once an admission, under the lock.
+        std::lock_guard<std::mutex> lock(_clientsMutex);
+        const std::string& address = connectionState->getRemoteIp();
+        std::map<std::string, size_t> heldBy;
+        for (const auto& socket : _admittedSockets)
+        {
+            pollfd ends {socket.probeFd, POLLRDHUP, 0};
+            const bool open = ::poll(&ends, 1, 0) == 0 ||
+                              (ends.revents & (POLLRDHUP | POLLHUP | POLLERR | POLLNVAL)) == 0;
+            if (open) ++heldBy[socket.state->getRemoteIp()];
+        }
+        const auto held = [&heldBy](const std::string& ip)
+        {
+            const auto it = heldBy.find(ip);
+            return it == heldBy.end() ? size_t(0) : it->second;
+        };
+        const bool ownShareFull = held(address) >= kSocketsPerAddress;
+        if (ownShareFull || _admittedSockets.size() >= getMaxConnections())
+        {
+            if (_admittedSockets.size() >= 2 * getMaxConnections()) return false;
+            AdmittedSocket* yields = nullptr;
+            size_t yieldsHeld = 0;
+            for (auto& socket : _admittedSockets)
+            {
+                if (socket.upgradeFd < 0) continue;
+                if (ownShareFull && socket.state->getRemoteIp() != address) continue;
+                const size_t count = held(socket.state->getRemoteIp());
+                if (count > yieldsHeld)
+                {
+                    yields = &socket;
+                    yieldsHeld = count;
+                }
+            }
+            if (yields == nullptr) return false;
+            // Its read ends at once on its own thread, which never blocks this one. The dup keeps
+            // the number from meaning another file by now.
+            ::shutdown(yields->upgradeFd, SHUT_RDWR);
+            ::close(yields->upgradeFd);
+            yields->upgradeFd = -1;
+        }
+        const int upgradeFd = ::dup(fd);
+        if (upgradeFd < 0) return false;
+        // The probe's dup holds the socket open after its own thread closes it, so the FIN of our
+        // own close waits for settleUpgrade(forget) at the end of that thread.
+        const int probeFd = ::dup(fd);
+        if (probeFd < 0)
+        {
+            ::close(upgradeFd);
+            return false;
+        }
+        _admittedSockets.push_back({connectionState, upgradeFd, probeFd});
+        return true;
+    }
+
+    void WebSocketServer::settleUpgrade(const std::shared_ptr<ConnectionState>& connectionState,
+                                        bool forget)
+    {
+        std::lock_guard<std::mutex> lock(_clientsMutex);
+        for (auto it = _admittedSockets.begin(); it != _admittedSockets.end(); ++it)
+        {
+            if (it->state != connectionState) continue;
+            if (it->upgradeFd >= 0) ::close(it->upgradeFd);
+            it->upgradeFd = -1;
+            if (forget)
+            {
+                ::close(it->probeFd);
+                _admittedSockets.erase(it);
+            }
+            return;
+        }
+    }
