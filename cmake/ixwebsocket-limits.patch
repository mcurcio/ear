 #include <sstream>
 #include <stdio.h>
 #include <string.h>
@@ -49,6 +51,18 @@ namespace ix
     void SocketServer::logError(const std::string& str)
     {
         std::lock_guard<std::mutex> lock(_logMutex);
+        // ear: ixwebsocket-limits.patch. Any peer can cause a line per connection, so at most one
+        // every 10 s reaches the log: a peer must not be able to fill the disk. Every server in
+        // the process shares the one limit, so it needs no lock of its own.
+        static std::atomic<long long> nextLine {0};
+        const long long now = std::chrono::duration_cast<std::chrono::seconds>(
+                                  std::chrono::steady_clock::now().time_since_epoch())
+                                  .count();
+        long long due = nextLine.load();
+        if (now < due || !nextLine.compare_exchange_strong(due, now + 10))
+        {
+            return;
+        }
         fprintf(stderr, "%s\n", str.c_str());
     }
 
