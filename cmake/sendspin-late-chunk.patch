+// The chunk late at its start but not its end is played from where the timeline is: its late front
+// dropped by one hard sync, the rest sent whole, no silence ahead of it.
+TEST(PlayerHardSync, AChunkLateAtItsStartGetsItsFrontDropped) {
+    constexpr uint32_t CHUNK_FRAMES = 4410; // 100 ms at 44.1 kHz
+    constexpr uint32_t LATE_FRAMES = 2205;  // 50 ms late at its start
+    auto impl = make_impl();
+    RecordingSink sink;
+    impl->listener = &sink;
+    SyncContext context;
+    context.current_stream_info = AudioStreamInfo(16, 2, 44100);
+    context.bytes_per_frame = context.current_stream_info.frames_to_bytes(1);
+    const size_t chunk_bytes = context.current_stream_info.frames_to_bytes(CHUNK_FRAMES);
+    ASSERT_TRUE(context.decode_buffer.allocate(chunk_bytes + context.bytes_per_frame,
+                                               MemoryLocation::PREFER_INTERNAL));
+    context.decode_buffer.set_listener(&sink);
+    // Frame n's every byte is n's low byte plus one, so the first byte out names the first frame.
+    uint8_t* end = context.decode_buffer.get_buffer_end();
+    for (uint32_t frame = 0; frame < CHUNK_FRAMES; ++frame)
+        std::memset(end + frame * context.bytes_per_frame, static_cast<uint8_t>(frame + 1),
+                    context.bytes_per_frame);
+    context.decode_buffer.increase_buffer_length(chunk_bytes);
+    // An estimate a second ahead of now, so no floor and no underrun touch it while this runs.
+    const int64_t playtime = platform_time_us() + 1'000'000;
+    context.new_audio_client_playtime = playtime;
+    context.decoded_timestamp =
+        playtime - context.current_stream_info.frames_to_microseconds(LATE_FRAMES);
+    context.hard_syncing = false;
+    context.aligning = false;
+    const int64_t chunk_us = context.current_stream_info.frames_to_microseconds(CHUNK_FRAMES);
+    ASSERT_FALSE(SyncTask::chunk_too_late(context.decoded_timestamp, chunk_us, playtime));
+
+    SyncTask& task = *impl->sync_task;
+    SyncTaskState state = task.handle_synchronize_audio(context);
+    while (state != SyncTaskState::LOAD_CHUNK) {
+        state = state == SyncTaskState::SYNCHRONIZE_AUDIO ? task.handle_synchronize_audio(context)
+                                                          : task.handle_transfer_audio(context);
+    }
+
+    // Its front dropped, within a frame of the lateness, and the rest sent whole: no silence.
+    const uint32_t sent = context.current_stream_info.bytes_to_frames(sink.written.size());
+    EXPECT_NEAR(static_cast<double>(sent), static_cast<double>(CHUNK_FRAMES - LATE_FRAMES), 1.0);
+    ASSERT_FALSE(sink.written.empty());
+    EXPECT_NE(sink.written.front(), 0);
+    EXPECT_NEAR(static_cast<double>(sink.written.front()), static_cast<double>((LATE_FRAMES + 1) & 0xFF), 1.0);
+}
