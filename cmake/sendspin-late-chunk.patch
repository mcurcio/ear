+// ear: sendspin-late-chunk.patch. A chunk is skipped as too late only once its last frame is: one
+// whose start is late but whose end is not is played, so a catch-up lands in one hard sync.
+TEST(PlayerHardSync, AChunkIsTooLateOnlyOnceItsLastFrameIs) {
+    constexpr int64_t PLAYTIME = 1'000'000'000;
+    constexpr int64_t CHUNK_US = 96'000;
+    struct Row {
+        const char* name;
+        int64_t start;
+        bool too_late;
+    };
+    const Row rows[] = {
+        {"Control: on time", PLAYTIME, false},
+        {"late at its start by more than the threshold, on time at its end", PLAYTIME - 60'000, false},
+        {"Control: its end just within the threshold", PLAYTIME - CHUNK_US - 5'000, false},
+        {"its end just past the threshold", PLAYTIME - CHUNK_US - 5'001, true},
+        {"late by more than a chunk", PLAYTIME - 200'000, true},
+    };
+    for (const Row& row : rows) {
+        SCOPED_TRACE(row.name);
+        EXPECT_EQ(SyncTask::chunk_too_late(row.start, CHUNK_US, PLAYTIME), row.too_late);
+    }
+}
