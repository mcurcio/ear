+    NurseryEntry* yields = nullptr;
+    for (auto& entry : this->nursery_) {
+        const SendspinConnection& occupant = *entry.conn;
+        if (occupant.is_outbound()) {
+            continue;
+        }
+        ++inbound_count;
+        const bool proved = occupant.is_operational() ||
+                            (occupant.is_noise_handshake_complete() &&
+                             occupant.get_psk_category() == PskCategory::LONG_TERM);
+        if (!proved && (yields == nullptr || yield_rank(occupant) < yield_rank(*yields->conn))) {
+            yields = &entry;
         }
     }
     if (inbound_count >= NURSERY_CAPACITY) {
-        SS_LOGW(TAG, "Nursery full of live connections, rejecting new connection");
-        this->release_connection(std::move(conn), SendspinGoodbyeReason::ANOTHER_SERVER);
-        return;
+        if (yields == nullptr) {
+            SS_LOGD(TAG, "Nursery full of proved connections, rejecting new connection");
+            this->release_connection(std::move(conn), SendspinGoodbyeReason::ANOTHER_SERVER);
+            return;
+        }
+        SS_LOGD(TAG, "Nursery full, an unproved occupant gives way");
+        this->release_nursery_entry(yields, std::nullopt);
     }
 
     SS_LOGD(TAG, "Admitting new connection into the nursery");
