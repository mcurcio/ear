+// ear: sendspin-starved-floor.patch. With frames still buffered the sink has not starved: a playtime
+// trailing now is a report dated behind it (a sink catching up after a stall), so it is kept.
+TEST(PlayerHardSync, AnEstimateWithFramesBufferedIsNotFloored) {
+    constexpr int64_t NOW = 1'000'000'000;
+    EXPECT_EQ(SyncTask::starved_playtime_floor(NOW - 5'001, NOW, 1), NOW - 5'001);
+    EXPECT_EQ(SyncTask::starved_playtime_floor(NOW - 20'000'000, NOW, 4608), NOW - 20'000'000);
+}
