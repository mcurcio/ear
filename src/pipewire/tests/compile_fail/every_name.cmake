# cmake -DSOURCE=<file> -DCASE=<macro> -P every_name.cmake -- <compiler> <flag>...
#
# One compile for many refusals: SOURCE compiled with -D<CASE> must be refused as poisoned for every name the CASE block
# lists, one bare identifier per line between `#ifdef <CASE>` and its `#endif`. Fails naming each name the compiler did
# not refuse as "attempt to use poisoned", and when the block lists none (a check of nothing passes nothing).
foreach(variable SOURCE CASE)
	if(NOT DEFINED ${variable})
		message(FATAL_ERROR "every_name: ${variable} is not set")
	endif()
endforeach()
set(command "")
set(after FALSE)
math(EXPR last "${CMAKE_ARGC} - 1")
foreach(index RANGE ${last})
	if(after)
		list(APPEND command "${CMAKE_ARGV${index}}")
	elseif(CMAKE_ARGV${index} STREQUAL "--")
		set(after TRUE)
	endif()
endforeach()
if(NOT command)
	message(FATAL_ERROR "every_name: no compiler after --")
endif()

file(STRINGS "${SOURCE}" lines)
set(names "")
set(inside FALSE)
foreach(line IN LISTS lines)
	if(line STREQUAL "#ifdef ${CASE}")
		set(inside TRUE)
	elseif(inside AND line STREQUAL "#endif")
		break()
	elseif(inside AND line MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
		list(APPEND names "${line}")
	endif()
endforeach()
list(LENGTH names count)
if(count EQUAL 0)
	message(FATAL_ERROR "every_name: no name listed under #ifdef ${CASE} in ${SOURCE}: the check would check nothing")
endif()

execute_process(COMMAND ${command} -D${CASE} "${SOURCE}" OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE result)
set(missing "")
foreach(name IN LISTS names)
	string(FIND "${out}${err}" "attempt to use poisoned \"${name}\"" at)
	if(at EQUAL -1)
		list(APPEND missing "${name}")
	endif()
endforeach()
if(missing)
	list(JOIN missing ", " missing)
	message(FATAL_ERROR "every_name: compiled without refusing as poisoned: ${missing}")
endif()
if(result EQUAL 0)
	message(FATAL_ERROR "every_name: the compiler accepted ${SOURCE} with ${CASE}")
endif()
message(STATUS "every_name: ${count} names, each refused as poisoned")
