# Run with cmake -DDOC=<docs/writing-a-node-type.md> -DOUT=<folder> -P: writes the worked example's files (each a
# "### `src/nodes/tone/<path>`" heading followed by one fenced block) into <folder>/<path>, so the tests beside it can
# compile them against today's headers. Fails when the page holds fewer than the five files the example is made of.
cmake_policy(VERSION 3.28)
file(READ "${DOC}" text)
set(prefix "### `src/nodes/tone/")
set(found 0)
file(REMOVE_RECURSE "${OUT}")
while(TRUE)
	string(FIND "${text}" "${prefix}" at)
	if(at EQUAL -1)
		break()
	endif()
	string(LENGTH "${prefix}" skip)
	math(EXPR at "${at} + ${skip}")
	string(SUBSTRING "${text}" ${at} -1 text)
	string(FIND "${text}" "`" end)
	string(SUBSTRING "${text}" 0 ${end} path)
	# The block: from the line after its opening fence to its closing fence.
	string(FIND "${text}" "```" open)
	string(SUBSTRING "${text}" ${open} -1 text)
	string(FIND "${text}" "\n" line_end)
	math(EXPR line_end "${line_end} + 1")
	string(SUBSTRING "${text}" ${line_end} -1 text)
	string(FIND "${text}" "```" close)
	string(SUBSTRING "${text}" 0 ${close} body)
	string(SUBSTRING "${text}" ${close} -1 text)
	file(WRITE "${OUT}/${path}" "${body}")
	math(EXPR found "${found} + 1")
endwhile()
if(found LESS 5)
	message(FATAL_ERROR "${DOC}: found ${found} of the worked example's files, not 5")
endif()
message(STATUS "wrote ${found} files of the worked example into ${OUT}")
