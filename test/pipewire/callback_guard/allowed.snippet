// What only looks like a registration: none of these lines may be refused (ear_callback_guard_allows_lookalikes).
	event_ = addEvent(loop, guarded<&Thing::onEvent>, this);
	timer_ = addTimer(loop, guarded<&Thing::onTimeout>, this);
	invoke(dataLoop, realtime<&Thing::onRequests>, this, false);
	listen<FilterCallbacks<Thing>{.process = realtime<&Thing::onProcess>}>(filter_, listener_, this);
	pw_loop_signal_event(loop, event_);
	pw_loop_update_timer(loop, timer_, &value, nullptr, false);
	pw_loop_destroy_source(loop, event_);
	spa_hook_remove(&listener_);
	pw_filter_get_data_loop(filter_);
	std::size_t add_listener_count = 0;
	reinvoke(loop);
	listeners.push_back(&listener);
	installLog<LogCallbacks{.log = realtimeFunction<&logPlain>}>(SPA_LOG_LEVEL_WARN);
	setAlsaErrorHandler(realtimeFunction<&alsaError>);
	invoke(DataLoop::of(filter_), realtime<&Thing::onRequests>, this, false);
	pw_log_set_level(SPA_LOG_LEVEL_WARN);
	filter_ = pw_filter_new(core, "ear", props);
	spa_hook_list_clean(&listeners_);
	pw_loop_invoked_count = 0;
	std::size_t method_count = 0;
	listenRealtime<NodeRealtimeCallbacks<Thing>{.start = realtime<&Thing::onStart>}>(clock_, listener_, this);
	pw_impl_node_remove_rt_listener(clock_, &hook_);
