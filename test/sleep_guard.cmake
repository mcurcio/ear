# cmake -DROOT=<folder> -DLIST=<listing> [-DGLOB=<pattern>,...] [-DFILTER=<regex>] -P sleep_guard.cmake
#
# The sleep guard of docs/testing.md#the-sleep-guard: a test waits for the event it needs, so every sleep in the tests
# and their support is listed with its role, and so is every Catch WARN (or CHECK_NOFAIL), which tells and goes on
# where a test should have failed naming what it waited for. Every file under ROOT matching GLOB (default: C and C++
# sources and headers and Python) whose path below ROOT matches FILTER (default: every one) is read a line at a time;
# a line that calls sleep_for, sleep_until, sleep, usleep, nanosleep, clock_nanosleep, Python's time.sleep or
# asyncio.sleep, poll on no descriptors or select on none, or WARN, CATCH_WARN or CHECK_NOFAIL (outside a string or a
# comment) must be listed in LIST, by its path below ROOT and its text, trimmed, as often as it occurs there. A line
# not listed is printed with its place, an entry that matches no line is printed as stale, and the script fails, as it
# does when ROOT and GLOB match no file (a guard over nothing passes nothing). LIST's format and roles are in its own
# header (test/sleeps.txt).
cmake_minimum_required(VERSION 3.28)
if(NOT DEFINED ROOT)
	message(FATAL_ERROR "sleep_guard: ROOT is not set")
endif()
if(NOT DEFINED LIST OR NOT EXISTS "${LIST}")
	message(FATAL_ERROR "sleep_guard: LIST (the listing of sleeps) is not set or does not exist: '${LIST}'")
endif()
if(NOT DEFINED GLOB)
	set(GLOB "*.cpp,*.hpp,*.c,*.h,*.py")
endif()
string(REPLACE "," ";" GLOB "${GLOB}") # commas, which a CTest command carries whole

# A file's lines as a CMake list. ';', '[', ']' and '\' would split or join list elements, so each is held as a control
# character until it is printed (decode()).
string(ASCII 1 semicolon)
string(ASCII 2 open)
string(ASCII 3 close)
string(ASCII 4 backslash)
string(ASCII 5 separator) # between a listed line's path and its text
function(read_lines file out)
	file(READ "${file}" content)
	string(REPLACE "\\" "${backslash}" content "${content}")
	string(REPLACE ";" "${semicolon}" content "${content}")
	string(REPLACE "[" "${open}" content "${content}")
	string(REPLACE "]" "${close}" content "${content}")
	string(REPLACE "\r" "" content "${content}")
	string(REPLACE "\n" ";" content "${content}")
	set(${out} "${content}" PARENT_SCOPE)
endfunction()
function(decode text out)
	string(REPLACE "${backslash}" "\\" text "${text}")
	string(REPLACE "${semicolon}" ";" text "${text}")
	string(REPLACE "${open}" "[" text "${text}")
	string(REPLACE "${close}" "]" text "${text}")
	set(${out} "${text}" PARENT_SCOPE)
endfunction()

set(sleep_rules
	"(^|[^A-Za-z0-9_])sleep_(for|until)[ \t]*\\("
	"(^|[^A-Za-z0-9_])(usleep|nanosleep|clock_nanosleep)[ \t]*\\("
	"(^|[^A-Za-z0-9_.>:])(::)?sleep[ \t]*\\("
	"(^|[^A-Za-z0-9_])(time|asyncio)\\.sleep[ \t]*\\("
	"(^|[^A-Za-z0-9_])poll[ \t]*\\([ \t]*(nullptr|NULL|0)[ \t]*,[ \t]*0[ \t]*,"
	"(^|[^A-Za-z0-9_])select[ \t]*\\([ \t]*0[ \t]*,")
set(warn_rule "(^|[^A-Za-z0-9_])(CATCH_)?(WARN|CHECK_NOFAIL)[ \t]*\\(")
set(roles induce negative poll pace luck owed)
string(JOIN ", " roles_shown ${roles})

set(offences 0)

# The listing: "<role> | <path> | <the line, trimmed> | <why>", '#' comments and blank lines aside.
read_lines("${LIST}" entries)
set(listed_keys)
set(listed_roles)
set(number 0)
foreach(entry IN LISTS entries)
	math(EXPR number "${number} + 1")
	string(STRIP "${entry}" entry)
	if(entry STREQUAL "" OR entry MATCHES "^#")
		continue()
	endif()
	string(FIND "${entry}" " | " first)
	string(FIND "${entry}" " | " last REVERSE)
	decode("${entry}" shown)
	if(first EQUAL -1 OR first EQUAL last)
		message(STATUS "${LIST}:${number}: not '<role> | <path> | <line> | <why>': ${shown}")
		math(EXPR offences "${offences} + 1")
		continue()
	endif()
	string(SUBSTRING "${entry}" 0 ${first} role)
	math(EXPR after "${first} + 3")
	math(EXPR whyAt "${last} + 3")
	string(SUBSTRING "${entry}" ${whyAt} -1 why)
	math(EXPR middle "${last} - ${after}")
	string(SUBSTRING "${entry}" ${after} ${middle} rest)
	string(FIND "${rest}" " | " split)
	if(split EQUAL -1)
		message(STATUS "${LIST}:${number}: not '<role> | <path> | <line> | <why>': ${shown}")
		math(EXPR offences "${offences} + 1")
		continue()
	endif()
	string(SUBSTRING "${rest}" 0 ${split} path)
	math(EXPR textAt "${split} + 3")
	string(SUBSTRING "${rest}" ${textAt} -1 text)
	string(STRIP "${role}" role)
	string(STRIP "${path}" path)
	string(STRIP "${text}" text)
	string(STRIP "${why}" why)
	if(NOT role IN_LIST roles)
		message(STATUS "${LIST}:${number}: unknown role '${role}' (one of ${roles_shown}): ${shown}")
		math(EXPR offences "${offences} + 1")
		continue()
	endif()
	if(why STREQUAL "")
		message(STATUS "${LIST}:${number}: says no why: ${shown}")
		math(EXPR offences "${offences} + 1")
		continue()
	endif()
	if((role STREQUAL "luck" OR role STREQUAL "owed") AND NOT why MATCHES "R5[bcd]")
		message(STATUS "${LIST}:${number}: a ${role} entry names no audit step (R5b, R5c or R5d) that removes it: ${shown}")
		math(EXPR offences "${offences} + 1")
		continue()
	endif()
	list(APPEND listed_keys "${path}${separator}${text}")
	list(APPEND listed_roles "${role}")
endforeach()
list(LENGTH listed_keys listed_count)

set(patterns)
foreach(pattern IN LISTS GLOB)
	list(APPEND patterns "${ROOT}/${pattern}")
endforeach()
file(GLOB_RECURSE files LIST_DIRECTORIES false ${patterns})
list(SORT files)

set(checked 0)
set(found 0)
foreach(file IN LISTS files)
	file(RELATIVE_PATH relative "${ROOT}" "${file}")
	if(DEFINED FILTER AND NOT relative MATCHES "${FILTER}")
		continue()
	endif()
	math(EXPR checked "${checked} + 1")
	set(python FALSE)
	if(relative MATCHES "\\.py(\\.snippet)?$")
		set(python TRUE)
	endif()
	read_lines("${file}" lines)
	set(number 0)
	foreach(line IN LISTS lines)
		math(EXPR number "${number} + 1")
		# The code alone: strings emptied (escapes first), then comments cut.
		set(code "${line}")
		string(REPLACE "${backslash}${backslash}" "" code "${code}")
		string(REPLACE "${backslash}\"" "" code "${code}")
		string(REPLACE "'\"'" "''" code "${code}")
		string(REGEX REPLACE "\"[^\"]*\"" "\"\"" code "${code}")
		if(python)
			string(REPLACE "${backslash}'" "" code "${code}")
			string(REGEX REPLACE "'[^']*'" "''" code "${code}")
			string(REGEX REPLACE "#.*$" "" code "${code}")
		else()
			string(REGEX REPLACE "/\\*.*\\*/" "" code "${code}")
			string(REGEX REPLACE "//.*$" "" code "${code}")
			string(STRIP "${code}" stripped)
			if(stripped MATCHES "^(\\*|/\\*)")
				continue()
			endif()
		endif()
		set(kind "")
		if(code MATCHES "${warn_rule}")
			set(kind "WARN")
		else()
			foreach(rule IN LISTS sleep_rules)
				if(code MATCHES "${rule}")
					set(kind "sleep")
					break()
				endif()
			endforeach()
		endif()
		if(kind STREQUAL "")
			continue()
		endif()
		math(EXPR found "${found} + 1")
		string(STRIP "${line}" text)
		decode("${text}" shown)
		list(FIND listed_keys "${relative}${separator}${text}" at)
		if(at EQUAL -1)
			message(STATUS "${relative}:${number}: unlisted ${kind}: ${shown}")
			math(EXPR offences "${offences} + 1")
			continue()
		endif()
		list(GET listed_roles ${at} role)
		list(REMOVE_AT listed_keys ${at})
		list(REMOVE_AT listed_roles ${at})
		if(kind STREQUAL "WARN" AND NOT (role STREQUAL "luck" OR role STREQUAL "owed"))
			message(STATUS "${relative}:${number}: a WARN goes on, so it is listed only as luck or owed, not ${role}: "
				"${shown}")
			math(EXPR offences "${offences} + 1")
		elseif(kind STREQUAL "sleep" AND role STREQUAL "owed")
			message(STATUS "${relative}:${number}: a sleep is listed by its role, never owed: ${shown}")
			math(EXPR offences "${offences} + 1")
		endif()
	endforeach()
endforeach()

foreach(key IN LISTS listed_keys)
	decode("${key}" shown)
	string(REPLACE "${separator}" " | " shown "${shown}")
	message(STATUS "${LIST}: listed but not found: ${shown}")
	math(EXPR offences "${offences} + 1")
endforeach()

if(checked EQUAL 0)
	message(FATAL_ERROR "sleep_guard: no file under ${ROOT} matches ${GLOB}: the guard would check nothing")
endif()
if(offences GREATER 0)
	message(FATAL_ERROR "sleep_guard: ${offences} offences under ${ROOT} against ${LIST}: a test waits for its event, "
		"and a sleep or a WARN is listed with its role (docs/testing.md#the-sleep-guard)")
endif()
message(STATUS "sleep_guard: ${checked} files under ${ROOT}, ${found} sleeps and WARNs, each listed in ${LIST}")
